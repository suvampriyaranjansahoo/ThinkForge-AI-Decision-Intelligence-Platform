{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"ThinkForge RAG Gold Label v1",
  "type":"object",
  "required":["studyId","queryId","query","labels"],
  "properties":{
    "studyId":{"type":"string"},
    "queryId":{"type":"string"},
    "query":{"type":"string"},
    "labels":{"type":"array","items":{"type":"object","required":["chunkId","relevance"],"properties":{"chunkId":{"type":"string"},"relevance":{"enum":["RELEVANT","PARTIALLY_RELEVANT","IRRELEVANT","CONTRADICTORY"]},"rank_priority":{"type":"integer","minimum":1},"note":{"type":"string","maxLength":1000}}}},
    "confidence":{"type":"number","minimum":1,"maximum":5},
    "raterId":{"type":"string"}
  },
  "additionalProperties":false
}
