JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# Stage 1 semantic intelligence
SEMANTIC_DISCOVERY_MODE=llm

# Optional durable live DB verification is run with SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY

